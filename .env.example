# ── Tableau de bord web (app.py) ─────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false

# ── Envoi d'emails (ai_news.py) ──────────────────────────────────────────────
# Destinataire
EMAIL_TO=ton.email@example.com

# Expéditeur
EMAIL_FROM=expediteur@example.com

# Configuration SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ton.login@example.com
SMTP_PASSWORD=ton_mot_de_passe

# Utiliser TLS (true/false)
SMTP_TLS=true
