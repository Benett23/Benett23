# ============================================================
# Configuration Système PTP Multi-Agents — Chris Gnabroyou
# ============================================================

# --- API Anthropic (Claude) ---
# Créer une clé sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Gmail (expéditeur + débrief) ---
# Adresse Gmail depuis laquelle envoyer les debriefs
GMAIL_USER=votre.email@gmail.com

# Mot de passe d'application Gmail (pas votre vrai mot de passe !)
# Créer sur : https://myaccount.google.com/apppasswords
# Activer d'abord la double authentification sur votre compte Google
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Adresse email destinataire du débrief (généralement la même)
DEBRIEF_EMAIL_TO=votre.email@gmail.com

# --- Répertoires de sortie ---
OUTPUT_DIR=outputs/dossier_ptp
DRAFTS_DIR=outputs/drafts
LOGS_DIR=outputs/logs
