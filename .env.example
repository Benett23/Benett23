# ============================================================
# Configuration Système PTP Multi-Agents — Chris Gnabroyou
# ============================================================

# --- Claude Code (pas de clé API nécessaire) ---
# Le système utilise `claude` CLI via votre abonnement Claude Code.
# Assurez-vous que `claude` est installé et authentifié :
#   claude --version   (doit afficher la version)
#   claude auth login  (si pas encore connecté)
# AUCUNE clé ANTHROPIC_API_KEY nécessaire.

# --- Gmail (expéditeur + débrief) ---
GMAIL_USER=votre.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
DEBRIEF_EMAIL_TO=votre.email@gmail.com

# --- Répertoires de sortie ---
OUTPUT_DIR=outputs/dossier_ptp
DRAFTS_DIR=outputs/drafts
LOGS_DIR=outputs/logs

# ============================================================
# DÉPLOIEMENT PWA MOBILE (iOS) — Optionnel
# ============================================================

# --- Supabase (base de données gratuite) ---
# Créer un compte sur : https://supabase.com
# Projet > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- OneSignal (notifications push gratuites) ---
# Créer un compte sur : https://onesignal.com
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_REST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Vercel (URL du PWA déployé) ---
VERCEL_URL=https://ptp-votre-nom.vercel.app
